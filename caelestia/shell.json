{
    "appearance": {
        "font": {
            "family": {
                "clock": "Rubik",
                "material": "Material Symbols Rounded",
                "mono": "CaskaydiaCove NF",
                "sans": "JetBrains Mono ExtraLight"
            },
            "size": {
                "scale": 1
            }
        },
        "transparency": {
            "base": 0.85,
            "enabled": true,
            "layers": 0.4
        }
    },
    "background": {
        "desktopClock": {
            "enabled": false,
            "invertColors": false,
            "shadow": {
                "enabled": true
            }
        },
        "enabled": true,
        "wallpaperEnabled": true
    },
    "bar": {
        "activeWindow": {
            "compact": true
        },
        "excludedScreens": [
        ],
        "status": {
            "showAudio": true,
            "showBattery": true,
            "showBluetooth": true
        },
        "tray": {
            "hiddenIcons": [
                "fcitx",
                "fcitx5",
                "Fcitx",
                "fcitx-unikey"
            ]
        },
        "workspaces": {
            "maxWindowIcons": 7
        }
    },
    "general": {
        "apps": {
            "terminal": [
                "kitty"
            ]
        },
        "idle": {
            "timeouts": [
            ]
        },
        "logo": "/home/cuong/Pictures/icons/logo.svg",
        "mediaGifSpeedAdjustment": 150,
        "sessionGifSpeed": 2
    },
    "launcher": {
        "actions": [
            {
                "command": [
                    "quickshell",
                    "-c",
                    "caelestia",
                    "ipc",
                    "call",
                    "controlCenter",
                    "open"
                ],
                "description": "Configure the shell",
                "icon": "settings",
                "name": "Settings"
            },
            {
                "command": [
                    "loginctl",
                    "lock-session"
                ],
                "description": "Lock the current session",
                "icon": "lock",
                "name": "Lock"
            },
            {
                "command": [
                    "systemctl",
                    "suspend-then-hibernate"
                ],
                "description": "Suspend then hibernate",
                "icon": "bedtime",
                "name": "Sleep"
            },
            {
                "command": [
                    "autocomplete",
                    "wallpaper"
                ],
                "description": "Change the current wallpaper",
                "icon": "wallpaper",
                "name": "Wallpaper"
            },
            {
                "command": [
                    "caelestia",
                    "wallpaper",
                    "-r"
                ],
                "description": "Switch to a random wallpaper",
                "icon": "shuffle",
                "name": "Random wallpaper"
            }
        ],
        "hiddenApps": [
            "org.gnome.Settings"
        ]
    },
    "paths": {
        "mediaGif": "/home/cuong/Pictures/gifs/shigure-ui-dance.gif",
        "sessionGif": "/home/cuong/Pictures/gifs/teto-animation.gif"
    },
    "services": {
        "useFahrenheit": false,
        "useFahrenheitPerformance": false
    }
}
